# Vano Ventures Environment Variables Configuration
# Copy this file to .env.local and fill in real values when ready for production.

# Web3Forms API Key (get yours free at https://web3forms.com/)
VITE_WEB3FORMS_ACCESS_KEY=[WEB3FORMS_ACCESS_KEY]

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=[GA_MEASUREMENT_ID]

# Canonical Site URL
VITE_SITE_URL=https://vanoventures.com

# Contact Info
VITE_CONTACT_EMAIL=contact@vanoventures.com
VITE_WHATSAPP_NUMBER=919876543210
VITE_WHATSAPP_DISPLAY=+91 98765 43210

# Branding Assets (Leave blank to use elegant [VANO VENTURES LOGO] placeholders)
# VITE_VANO_LOGO=/assets/logo.svg
# VITE_VANO_FAVICON=/favicon.svg
# VITE_VANO_OG_IMAGE=/og-image.png

# Social Links (Only defined URLs will appear in the UI)
# VITE_INSTAGRAM_URL=https://instagram.com/vanoventures
# VITE_GITHUB_URL=https://github.com/vano-ventures
# VITE_LINKEDIN_URL=https://linkedin.com/company/vano-ventures
# VITE_X_URL=https://x.com/vanoventures
